# ============================================================
# AI Hallucination Stress Tester — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- LLM Provider ---
# Choose: "gemini" or "openai"
LLM_PROVIDER=gemini

# --- Google Gemini API Key ---
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenAI API Key (optional fallback) ---
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- OpenAI Model (used only if LLM_PROVIDER=openai) ---
OPENAI_MODEL=gpt-3.5-turbo

# --- Gemini Model (used only if LLM_PROVIDER=gemini) ---
GEMINI_MODEL=gemini-1.5-flash

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS: Frontend origin (set to your actual frontend URL in production) ---
FRONTEND_ORIGIN=*

# --- Embedding Model (local, no API key needed) ---
# Default: all-MiniLM-L6-v2 (~80MB, downloaded on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- RAG Settings ---
# Number of Wikipedia passages to retrieve per query
RAG_TOP_K=5
# Max characters per evidence passage
RAG_PASSAGE_MAX_CHARS=500
